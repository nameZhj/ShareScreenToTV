<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="alertDialogTheme">@style/TvDialogTheme</item>
    </style>

    <style name="TvDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#212121</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
        <item name="colorAccent">#2979FF</item>
        <item name="android:windowMinWidthMajor">55%</item>
        <item name="android:windowMinWidthMinor">55%</item>
    </style>
</resources>
